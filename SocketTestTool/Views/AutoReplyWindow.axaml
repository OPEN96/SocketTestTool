<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:SocketTestTool.ViewModels"
        xmlns:models="using:SocketTestTool.Models"
        x:Class="SocketTestTool.Views.AutoReplyWindow"
        x:DataType="vm:MainWindowViewModel"
        Width="900" Height="620" MinWidth="760" MinHeight="480"
        Title="自动应答规则"
        WindowStartupLocation="CenterOwner"
        Background="#F3F5F9">

  <Window.Resources>
    <SolidColorBrush x:Key="AccentBrush" Color="#3B6CF0"/>
    <SolidColorBrush x:Key="AccentDarkBrush" Color="#2E5AE0"/>
    <SolidColorBrush x:Key="AccentLightBrush" Color="#EAF0FE"/>
    <SolidColorBrush x:Key="CardBrush" Color="#FFFFFF"/>
    <SolidColorBrush x:Key="CardBorderBrush" Color="#E4E8F0"/>
    <SolidColorBrush x:Key="MutedBrush" Color="#6B768A"/>
    <SolidColorBrush x:Key="SubtleBrush" Color="#9AA3B4"/>
    <SolidColorBrush x:Key="TextBrush" Color="#2A3342"/>
    <SolidColorBrush x:Key="SubPanelBrush" Color="#F7F9FC"/>
    <SolidColorBrush x:Key="OkBrush" Color="#2E7D4F"/>
  </Window.Resources>

  <Window.Styles>
    <Style Selector="TextBlock.section-title">
      <Setter Property="FontSize" Value="13"/>
      <Setter Property="FontWeight" Value="SemiBold"/>
      <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
      <Setter Property="VerticalAlignment" Value="Center"/>
    </Style>
    <Style Selector="TextBlock.field-label">
      <Setter Property="VerticalAlignment" Value="Center"/>
      <Setter Property="Foreground" Value="{StaticResource MutedBrush}"/>
      <Setter Property="FontSize" Value="12"/>
    </Style>
    <Style Selector="TextBlock.hint">
      <Setter Property="FontSize" Value="11"/>
      <Setter Property="Foreground" Value="{StaticResource SubtleBrush}"/>
      <Setter Property="VerticalAlignment" Value="Center"/>
    </Style>
    <Style Selector="Border.badge">
      <Setter Property="Background" Value="{StaticResource AccentLightBrush}"/>
      <Setter Property="CornerRadius" Value="4"/>
      <Setter Property="Padding" Value="6,2"/>
    </Style>
    <Style Selector="Border.badge > TextBlock">
      <Setter Property="FontSize" Value="11"/>
      <Setter Property="Foreground" Value="{StaticResource AccentBrush}"/>
    </Style>
    <Style Selector="Border.card">
      <Setter Property="Background" Value="{StaticResource CardBrush}"/>
      <Setter Property="BorderBrush" Value="{StaticResource CardBorderBrush}"/>
      <Setter Property="BorderThickness" Value="1"/>
      <Setter Property="CornerRadius" Value="10"/>
      <Setter Property="Padding" Value="14"/>
    </Style>
    <Style Selector="Border.subpanel">
      <Setter Property="Background" Value="{StaticResource SubPanelBrush}"/>
      <Setter Property="BorderBrush" Value="{StaticResource CardBorderBrush}"/>
      <Setter Property="BorderThickness" Value="1"/>
      <Setter Property="CornerRadius" Value="6"/>
      <Setter Property="Padding" Value="10,8"/>
    </Style>
    <Style Selector="TextBox">
      <Setter Property="CornerRadius" Value="6"/>
      <Setter Property="Padding" Value="8,5"/>
    </Style>
    <Style Selector="TextBox.mono">
      <Setter Property="FontFamily" Value="Consolas,Menlo,Monospace"/>
      <Setter Property="FontSize" Value="12"/>
    </Style>
    <Style Selector="Button">
      <Setter Property="CornerRadius" Value="6"/>
      <Setter Property="Padding" Value="12,5"/>
      <Setter Property="FontWeight" Value="SemiBold"/>
    </Style>
    <Style Selector="Button.primary">
      <Setter Property="Background" Value="{StaticResource AccentBrush}"/>
      <Setter Property="Foreground" Value="White"/>
    </Style>
    <Style Selector="Button.primary:pointerover /template/ ContentPresenter">
      <Setter Property="Background" Value="{StaticResource AccentDarkBrush}"/>
    </Style>
    <Style Selector="Button.ghost">
      <Setter Property="Background" Value="Transparent"/>
      <Setter Property="BorderBrush" Value="{StaticResource CardBorderBrush}"/>
      <Setter Property="Foreground" Value="#4A5568"/>
      <Setter Property="FontWeight" Value="Normal"/>
    </Style>
    <Style Selector="Button.danger">
      <Setter Property="Background" Value="Transparent"/>
      <Setter Property="BorderBrush" Value="#F5C6CB"/>
      <Setter Property="Foreground" Value="#C0392B"/>
      <Setter Property="FontWeight" Value="Normal"/>
    </Style>
  </Window.Styles>

  <Grid RowDefinitions="Auto,*,Auto" Margin="14">

    <!-- 顶部开关 -->
    <Border Grid.Row="0" Classes="card">
      <StackPanel Spacing="6">
        <StackPanel Orientation="Horizontal" Spacing="10">
          <TextBlock Text="自动应答" Classes="section-title"/>
          <CheckBox Content="启用自动应答" IsChecked="{Binding AutoReplyEnabled}"/>
          <TextBlock Text="{Binding AutoReplySummaryText}" Classes="hint" Margin="6,0,0,0"/>
        </StackPanel>
        <TextBlock Text="收到数据时按顺序匹配规则，命中即自动回复；规则按列表顺序全部参与匹配（可用「启用」列单独关闭某条）"
                   Classes="hint" TextWrapping="Wrap"/>
      </StackPanel>
    </Border>

    <!-- 规则列表 -->
    <Border Grid.Row="1" Classes="card" Margin="0,12,0,12">
      <Grid ColumnDefinitions="*,Auto">
        <ListBox Grid.Column="0" ItemsSource="{Binding AutoReplyRules}"
                 SelectedItem="{Binding SelectedRule}" Background="Transparent">
          <ListBox.ItemTemplate>
            <DataTemplate x:DataType="models:AutoReplyRule">
              <Grid ColumnDefinitions="Auto,*,Auto" Margin="2,5">
                <Border Grid.Column="0" Classes="badge" VerticalAlignment="Center" Margin="0,0,10,0">
                  <TextBlock Text="{Binding MatchModeText}"/>
                </Border>
                <StackPanel Grid.Column="1" Spacing="2">
                  <StackPanel Orientation="Horizontal" Spacing="8">
                    <TextBlock Text="{Binding Name}" FontWeight="SemiBold"
                               Foreground="{StaticResource TextBrush}"/>
                    <Border Classes="badge" IsVisible="{Binding MatchIsHex}">
                      <TextBlock Text="匹配 HEX"/>
                    </Border>
                    <Border Classes="badge" IsVisible="{Binding ReplyIsHex}">
                      <TextBlock Text="回复 HEX"/>
                    </Border>
                    <TextBlock Text="已停用" FontSize="11" Foreground="{StaticResource SubtleBrush}"
                               IsVisible="{Binding !Enabled}"/>
                  </StackPanel>
                  <TextBlock FontSize="11" Foreground="{StaticResource MutedBrush}"
                             TextTrimming="CharacterEllipsis">
                    <Run Text="匹配 "/>
                    <Run Text="{Binding MatchText}"/>
                    <Run Text="   →  回复 "/>
                    <Run Text="{Binding ReplyText}"/>
                  </TextBlock>
                </StackPanel>
                <Ellipse Grid.Column="2" Width="8" Height="8" VerticalAlignment="Center" Margin="10,0,0,0"
                         Fill="{StaticResource OkBrush}" IsVisible="{Binding Enabled}"/>
              </Grid>
            </DataTemplate>
          </ListBox.ItemTemplate>
        </ListBox>

        <StackPanel Grid.Column="1" Spacing="6" Margin="12,0,0,0" VerticalAlignment="Center">
          <Button Content="编辑" Width="96" HorizontalContentAlignment="Center"
                  Command="{Binding EditRuleCommand}"/>
          <Button Content="上移" Width="96" HorizontalContentAlignment="Center" Classes="ghost"
                  Command="{Binding MoveRuleUpCommand}"/>
          <Button Content="下移" Width="96" HorizontalContentAlignment="Center" Classes="ghost"
                  Command="{Binding MoveRuleDownCommand}"/>
          <Button Content="删除" Width="96" HorizontalContentAlignment="Center" Classes="danger"
                  Command="{Binding DeleteRuleCommand}"/>
        </StackPanel>
      </Grid>
    </Border>

    <!-- 编辑区 -->
    <Border Grid.Row="2" Classes="card">
      <StackPanel Spacing="10">
        <StackPanel Orientation="Horizontal" Spacing="10">
          <TextBlock Text="{Binding RuleFormTitle}" Classes="section-title"/>
          <TextBlock Text="HEX 匹配时忽略空格与大小写" Classes="hint"/>
        </StackPanel>

        <Grid ColumnDefinitions="Auto,*,Auto,Auto,130">
          <TextBlock Grid.Column="0" Text="名称" Classes="field-label" Margin="0,0,8,0"/>
          <TextBox Grid.Column="1" Text="{Binding RuleName}" PlaceholderText="如：应答查询指令"/>
          <TextBlock Grid.Column="2" Text="匹配方式" Classes="field-label" Margin="12,0,8,0"/>
          <ComboBox Grid.Column="3" Width="96" ItemsSource="{Binding MatchModes}"
                    SelectedIndex="{Binding RuleMatchMode}"/>
          <CheckBox Grid.Column="4" Content="匹配串为 HEX" IsChecked="{Binding RuleMatchIsHex}"
                    Margin="12,0,0,0" VerticalAlignment="Center"/>
        </Grid>

        <Grid ColumnDefinitions="56,*,Auto">
          <TextBlock Grid.Column="0" Text="匹配" Classes="field-label"/>
          <TextBox Grid.Column="1" Text="{Binding RuleMatchText}" Classes="mono"
                   PlaceholderText="收到的数据需包含的内容，如 01 03 或 hello"/>
          <CheckBox Grid.Column="2" Content="启用" IsChecked="{Binding RuleEnabled}"
                    Margin="12,0,0,0" VerticalAlignment="Center"/>
        </Grid>

        <Grid ColumnDefinitions="56,*,Auto">
          <TextBlock Grid.Column="0" Text="回复" Classes="field-label"/>
          <TextBox Grid.Column="1" Text="{Binding RuleReplyText}" Classes="mono"
                   PlaceholderText="命中后自动发送的内容，如 01 03 02 00 01"/>
          <CheckBox Grid.Column="2" Content="回复为 HEX" IsChecked="{Binding RuleReplyIsHex}"
                    Margin="12,0,0,0" VerticalAlignment="Center"/>
        </Grid>

        <StackPanel Orientation="Horizontal" Spacing="8">
          <Button Content="保存" Width="96" HorizontalContentAlignment="Center" Classes="primary"
                  Command="{Binding SaveRuleCommand}"/>
          <Button Content="新增" Width="96" HorizontalContentAlignment="Center" Classes="ghost"
                  Command="{Binding NewRuleCommand}"/>
        </StackPanel>
      </StackPanel>
    </Border>
  </Grid>
</Window>
