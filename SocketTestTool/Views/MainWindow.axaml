<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:SocketTestTool.ViewModels"
        xmlns:conv="using:SocketTestTool.Converters"
        x:Class="SocketTestTool.Views.MainWindow"
        x:DataType="vm:MainWindowViewModel"
        Width="980" Height="680" MinWidth="860" MinHeight="600"
        Title="Socket 测试工具">

  <Window.Resources>
    <conv:ConnectedBrushConverter x:Key="ConnectedBrush"/>
  </Window.Resources>

  <Grid RowDefinitions="Auto,*,Auto" Margin="12">

    <!-- ============ 连接配置区 ============ -->
    <Border Grid.Row="0" Padding="12" CornerRadius="8"
            BorderBrush="#E0E0E0" BorderThickness="1" Background="#FAFAFA">
      <StackPanel Spacing="10">

        <StackPanel Orientation="Horizontal" Spacing="14">
          <TextBlock Text="模式" VerticalAlignment="Center" FontWeight="SemiBold"/>
          <RadioButton Content="服务端" GroupName="Mode"
                       IsChecked="{Binding IsServerMode}"
                       IsEnabled="{Binding !IsConnected}"/>
          <RadioButton Content="客户端" GroupName="Mode"
                       IsEnabled="{Binding !IsConnected}"/>
          <Border Width="1" Background="#DDDDDD" Margin="4,2"/>
          <TextBlock Text="协议" VerticalAlignment="Center" FontWeight="SemiBold"/>
          <RadioButton Content="TCP" GroupName="Proto"
                       IsChecked="{Binding IsTcp}"
                       IsEnabled="{Binding !IsConnected}"/>
          <RadioButton Content="UDP" GroupName="Proto"
                       IsEnabled="{Binding !IsConnected}"/>
          <CheckBox Content="断线自动重连"
                    IsChecked="{Binding AutoReconnect}"
                    IsVisible="{Binding ShowReconnect}"/>
        </StackPanel>

        <StackPanel Orientation="Horizontal" Spacing="8">
          <TextBlock Text="地址" VerticalAlignment="Center" FontWeight="SemiBold"/>
          <TextBox Width="220" Text="{Binding Host}" IsEnabled="{Binding !IsConnected}"
                   PlaceholderText="客户端模式填目标 IP/域名"/>
          <TextBlock Text="端口" VerticalAlignment="Center" FontWeight="SemiBold"/>
          <TextBox Width="90" Text="{Binding Port}" IsEnabled="{Binding !IsConnected}"/>
          <Button Content="{Binding ActionText}"
                  Command="{Binding ToggleConnectionCommand}"
                  Padding="18,0"/>
          <Ellipse Width="10" Height="10" VerticalAlignment="Center"
                   Fill="{Binding IsConnected, Converter={StaticResource ConnectedBrush}}"/>
          <TextBlock Text="{Binding StatusText}" VerticalAlignment="Center" Foreground="#555555"/>
        </StackPanel>

      </StackPanel>
    </Border>

    <!-- ============ 中间：客户端列表 + 收发日志 ============ -->
    <Grid Grid.Row="1" ColumnDefinitions="Auto,*" Margin="0,10,0,10">

      <Border Grid.Column="0" Width="250" Margin="0,0,10,0" Padding="10"
              CornerRadius="8" BorderBrush="#E0E0E0" BorderThickness="1" Background="#FAFAFA"
              IsVisible="{Binding IsServerMode}">
        <DockPanel>
          <TextBlock DockPanel.Dock="Top" Text="已连接客户端" FontWeight="SemiBold" Margin="0,0,0,6"/>
          <TextBlock DockPanel.Dock="Bottom" Text="未选中时发送给全部"
                     FontSize="11" Foreground="#999999" Margin="0,6,0,0"/>
          <ListBox ItemsSource="{Binding Clients}" SelectedItem="{Binding SelectedClient}">
            <ListBox.ItemTemplate>
              <DataTemplate x:DataType="vm:ClientItem">
                <StackPanel>
                  <TextBlock Text="{Binding EndPoint}" FontWeight="SemiBold"/>
                  <TextBlock Text="{Binding ConnectedAtText}" FontSize="11" Foreground="#888888"/>
                </StackPanel>
              </DataTemplate>
            </ListBox.ItemTemplate>
          </ListBox>
        </DockPanel>
      </Border>

      <Border Grid.Column="1" Padding="10"
              CornerRadius="8" BorderBrush="#E0E0E0" BorderThickness="1" Background="#FAFAFA">
        <DockPanel>
          <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Spacing="12" Margin="0,0,0,6">
            <TextBlock Text="收发日志" FontWeight="SemiBold" VerticalAlignment="Center"/>
            <RadioButton Content="ASCII" GroupName="Disp"/>
            <RadioButton Content="HEX" GroupName="Disp" IsChecked="{Binding DisplayHex}"/>
            <CheckBox Content="记录到文件" IsChecked="{Binding IsFileLoggingEnabled}"/>
            <Button Content="导出日志" Command="{Binding ExportLogCommand}" Padding="12,0"/>
            <Button Content="清空" Command="{Binding ClearLogCommand}" Padding="12,0"/>
          </StackPanel>
          <ScrollViewer Name="LogScroll" Background="White"
                        HorizontalScrollBarVisibility="Auto"
                        VerticalScrollBarVisibility="Auto">
            <TextBlock Text="{Binding LogText}"
                       FontFamily="Consolas,Menlo,Monospace" FontSize="12"
                       TextWrapping="NoWrap" Padding="4"/>
          </ScrollViewer>
        </DockPanel>
      </Border>
    </Grid>

    <!-- ============ 数据发送区 ============ -->
    <Border Grid.Row="2" Padding="12" CornerRadius="8"
            BorderBrush="#E0E0E0" BorderThickness="1" Background="#FAFAFA">
      <StackPanel Spacing="8">
        <StackPanel Orientation="Horizontal" Spacing="12">
          <TextBlock Text="发送数据" FontWeight="SemiBold" VerticalAlignment="Center"/>
          <RadioButton Content="ASCII" GroupName="SendFmt"/>
          <RadioButton Content="HEX" GroupName="SendFmt" IsChecked="{Binding SendHex}"/>
          <TextBlock Text="HEX 示例：48 65 6C 6C 6F（空格可选）"
                     FontSize="11" Foreground="#999999" VerticalAlignment="Center"
                     IsVisible="{Binding SendHex}"/>
        </StackPanel>
        <Grid ColumnDefinitions="*,Auto">
          <TextBox Grid.Column="0" Text="{Binding SendText}"
                   AcceptsReturn="True" Height="72" TextWrapping="Wrap"
                   PlaceholderText="在此输入要发送的数据…"/>
          <StackPanel Grid.Column="1" Spacing="8" Margin="10,0,0,0">
            <Button Content="发送" Width="96" HorizontalContentAlignment="Center"
                    Command="{Binding SendCommand}"/>
            <Button Content="发送至全部" Width="96" HorizontalContentAlignment="Center"
                    Command="{Binding SendToAllCommand}"
                    IsVisible="{Binding IsServerMode}"/>
          </StackPanel>
        </Grid>
      </StackPanel>
    </Border>

  </Grid>
</Window>
