# Auto detect text files and perform LF normalization
* text=auto eol=lf

# Source files
*.cs       text eol=lf
*.axaml    text eol=lf
*.csproj   text eol=lf
*.slnx     text eol=lf
*.sln      text eol=lf
*.md       text eol=lf
*.yml      text eol=lf
*.yaml     text eol=lf
*.json     text eol=lf
*.manifest text eol=lf

# Binary files
*.png    binary
*.ico    binary
*.zip    binary
*.tar.gz binary
